# Build tag sets for the aiscan editions — the single source of truth shared by
# the Makefile and the CI workflows.
#
# This is a data file, not a script. The values hold spaces, so sourcing it in a
# shell would set each variable to its first word and try to run the rest. The
# Makefile `include`s it and the workflows append it to $GITHUB_ENV, both of
# which take the values verbatim; a shell that needs a value should read it out
# of the line instead of evaluating the file.
#
# Plain KEY=VALUE lines on purpose: it cannot use shell or make expansion.
#
# Most tags here have no build constraint anywhere in this repository. They
# select behaviour inside dependencies (the sqlite driver, go-re2, the embedded
# fingerprint resources, the net and os/user implementations), so the list can
# only be declared, never derived by scanning source. Editing it is editing the
# build contract — `TestBuildManifestIsConsistent` checks the relationships
# below, and the manifest tag tests check how a test binary was built.

# Base policy tags, shared by every edition. `emptytemplates` and `noembed` keep
# the resource templates outside the binary; `make EMBED=1` drops those two.
BASE_TAGS=forceposix emptytemplates noembed osusergo netgo

# Capability tags turned on per edition, on top of the base tags. The empty
# standard set is what a bare `go test ./cmd/aiscan` builds.
STANDARD_CAPS_TAGS=
FULL_CAPS_TAGS=full sqlite
RECORD_CAPS_TAGS=full sqlite record

# The complete tag sets, base plus capabilities, spelled out because this file
# is read without expansion. Keep them in step with the two groups above.
STANDARD_TAGS=forceposix emptytemplates noembed osusergo netgo
FULL_TAGS=forceposix emptytemplates noembed osusergo netgo full sqlite
RECORD_TAGS=forceposix emptytemplates noembed osusergo netgo full sqlite record

# CGO_ENABLED for each edition's build. Standard and full use the pure-Go RE2
# backend. Only record composes a native capture backend and requires cgo.
STANDARD_CGO=0
FULL_CGO=0
RECORD_CGO=1
