# Coordinates of the prebuilt native SDKs this repository downloads.
#
# `.github/native/sdk.sh` uses these to build the release URL and to check the
# extracted manifest. The SDKs themselves are built and published by
# chainreactors/native, which holds the authoritative copy of this file — keep
# the shared values identical and bump them together.
#
# Both families follow one shape:
#   asset:    native-<family>-<version>-<os>_<arch>.tar.gz  (+ .sha256)
#   tag:      native-<family>-<version>
#   manifest: family=<family> version=<version> platform=<os>_<arch> [extras]

NATIVE_REPOSITORY=chainreactors/native

# ---- static RE2 SDK -----------------------------------------------------
RE2_VERSION=2023-03-01
RE2_STATIC_VERSION=2023-03-01-1
RE2_STATIC_RELEASE=native-re2-2023-03-01-1

# ---- recorder SDK -------------------------------------------------------
RECORD_NATIVE_VERSION=ffmpeg-8.0.3-x264-0480cb05-3
RECORD_NATIVE_RELEASE=native-record-ffmpeg-8.0.3-x264-0480cb05-3

# ---- macOS CGO cross-build toolchain ------------------------------------
# Used by release-build.yml's Darwin cross job, not by the SDK downloads.
MACOS_CROSS_ZIG_VERSION=0.14.1
MACOS_CROSS_SDK_VERSION=14.5
MACOS_CROSS_SDK_SHA256=6e146275d19f027faa2e8354da5e0267513abf013b8f16ad65a231653a2b1c5d
MACOS_CROSS_DEPLOYMENT_TARGET=11.0
